.taore_ck
	P_DISTMORE	250,.pass
	P_IFARWING	.pass
	P_IFNOTZERO	childrotx,.pass1
	P_IMPORT	pword1,Player1_worldx
	P_IFSMALLER	pword1,ox,.pass1
	P_IFLARGER	pword1,childx,.pass1

