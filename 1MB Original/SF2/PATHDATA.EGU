	P_IFSAME	pbyte1,6,.sound_space
	P_IFSAME	pbyte1,7,.sound_space
.find_step
	P_DEC		pbyte2
	P_IFSAME	pbyte2,-1,.this_step

	P_GOSUB		.read_tab
	P_ADD		skidy,2
	P_DO		tx
	P_ADD		skidy,2
	P_INEXT
	P_IGOTO		.find_step
.read_tab
	P_IFZERO	pbyte1,.pl_1
	P_IFSAME	pbyte1,1,.pl_2	
	P_IFSAME	pbyte1,2,.pl_3	
	P_IFSAME	pbyte1,3,.pl_4	
	P_IFSAME	pbyte1,4,.pl_5	
	P_IFSAME	pbyte1,5,.pl_6	
	P_IFSAME	pbyte1,6,.so_1	
	P_IFSAME	pbyte1,7,.so_2	
	P_IFSAME	pbyte1,8,.so_3
	P_IFSAME	pbyte1,9,.ex_1	
	P_IFSAME	pbyte1,10,.ex_2
	P_IFSAME	pbyte1,11,.ex_3	
	P_IFSAME	pbyte1,12,.ex_4
.pl_1
	P_INDEX		tx,P1_STEP_0,skidy
	P_RETURN
.pl_2
	P_INDEX		tx,P2_STEP_0,skidy
	P_RETURN
.pl_3
