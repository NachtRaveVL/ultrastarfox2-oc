	P_GOTO		.mouaru
.atack
	P_DO		10
	P_SET		tx,2
	P_DO		3
	P_BECOMECHILD	tx
	P_ADD		childy,48
	P_UNBECOME
	P_INC		tx
	P_INEXT
	P_NEXT
	P_WAIT		1
	P_DO		10
	P_SET		tx,2
	P_DO		3
	P_BECOMECHILD	tx
	P_ADD		childy,-48
	P_UNBECOME
	P_INC		tx
	P_INEXT
	P_NEXT

	P_DO		15
	P_FACEPLAYER
	P_BECOMECHILD	1
	P_CHASE		childrotx,-64
	P_UNBECOME
	P_NEXT
	P_GOTO		.again

