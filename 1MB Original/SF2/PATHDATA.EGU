;------------
	START_PATH	e_game_maker_space

	P_TRIGGER	enemy_num_rem,Always

	P_INVISIBLE	ON	
	P_CLRTYPE	enemy1
	P_TRIGGER	pe_game_maker_planet.map_msg,Always
	P_TRIGGER	.pos_keep,8

	P_IMPORT	ty,Player_friend
	P_IFSAME	ty,-1,.pertner_nashi	;partner ga inai

	P_IMPORT	oy,eword2
	P_IFZERO	oy,.not_any_hajimete
	P_ADD		oy,ty
	P_MSG		oy
	P_SET		skidy,60
	P_ZERO		oy
	P_EXPORT	eword2,oy
.not_any_hajimete
	P_IMPORT	oy,eword3
	P_SET		tx,5				;hajimete henkei flag
	P_IFSWITCH	tx,oy,.pertner_nashi		;boost shitakoto aru
	P_TRIGGER	.teach_boost,128
	P_TRIGGER	.boost_ck,Always
.pertner_nashi
	P_END

.teach_boost
	P_IFNOTZERO	pword1,.ret
	P_IFNOTZERO	skidy,.ret
	P_IFNOTZERO	childrotx,.ret
	P_SET		pword1,142		;use boost msg num
	P_ADD		pword1,ty
	P_IFROBOT	.pass_msg
	P_IFUFO		.pass_msg
	P_IMPORT	ap,KGameMapPtr
	P_IFSAME	ap,4,.pass_msg
	P_MSG		pword1
.pass_msg
	P_ZERO		pword1
	P_SET		childrotx,3
.ret
	P_DEC		childrotx
	P_RETURN

.boost_ck
	P_IFPLAYERBOOST	.now_boost
	P_ZERO		pword1
	P_RETURN
.now_boost
	P_INC		pword1
	P_IFSAME	pword1,40,.ok_boost
	P_RETURN
.ok_boost
	P_SET		tx,5
	P_IMPORT	oy,eword3
	P_SETSWITCH	tx,oy
	P_EXPORT	eword3,oy
	P_FORCE		.boostshita
	P_RETURN

.boostshita
	P_TRIGGER	.teach_boost,OFF
	P_TRIGGER	.boost_ck,OFF
	P_END

.pos_keep
	P_COPYPLAYERPOS
	P_ADD		worldy,1000
	P_RETURN
;------------
henkei_ck_wait	equ	30

	START_PATH	e_game_maker_planet

	P_TRIGGER	enemy_num_rem,Always	;KEnemyNumber ga 0 ninattara removesuru

	P_INVISIBLE	ON	
	P_IMPORT	tx,KGameMapPtr
	P_IMPORT	ty,Player_friend
	P_CLRTYPE	enemy1
	P_SET		pbyte2,5		;ebyte6 no bit5 shitei
	P_SET		ox,worldx
	P_SET		childx,worldx
	P_NEG		childx
	P_SET		oz,worldz
	P_SET		childz,worldz
	P_NEG		childz

	P_TRIGGER	.map_msg,Always		;map no jyoukyou wo message suru

	P_WAIT		henkei_wait+henkei_ck_wait

	P_IFNOTSAME	ty,-1,.pertner_ari	;partner ga inai
	P_END
.pertner_ari
	P_IMPORT	oy,eword2
	P_IFZERO	oy,.not_any_hajimete
	P_ADD		oy,ty
	P_MSG		oy
	P_SET		skidy,60
	P_ZERO		oy
	P_EXPORT	eword2,oy
.not_any_hajimete
	P_IMPORT	oy,eword3
	P_SET		tx,16				;hajimete henkei flag
	P_IFSWITCH	tx,oy,.start
	P_TRIGGER	.teach_henkei,128
	P_TRIGGER	.henkei_ck,Always
.start
	P_TRIGGER	.pl_pos_ck,16
	P_END

.teach_henkei
	P_IFNOTZERO	skidy,.ret
	P_IFNOTZERO	childrotx,.ret
	P_SET		slopenum,56
	P_ADD		slopenum,ty
	P_MSG		slopenum
	P_SET		childrotx,3
.ret
	P_DEC		childrotx
	P_RETURN
.henkei_ck
	P_IMPORT	oy,eword3
	P_IFROBOT	.arwing
	P_SET		tx,16
	P_IMPORT	oy,eword3
	P_SETSWITCH	tx,oy
	P_EXPORT	eword3,oy
	P_FORCE		.henkeishita
.arwing
	P_RETURN

.henkeishita
	P_TRIGGER	.teach_henkei,OFF
	P_TRIGGER	.henkei_ck,OFF
	P_END
;------------
.map_msg	LOCAL

	P_IFNOTZERO	skidy,.no_act
	P_IMPORT	slopenum,Pepper_message
	P_IFZERO	slopenum,.no_act1

	P_MSG		slopenum

	P_IFSAME	ty,-1,.not_line			;partner ga inai

	P_IFSAME	slopenum,22,.map_line_fin
	P_IFSAME	slopenum,23,.map_line_fin
.not_line
	P_SET		skidy,60			;wait time
.no_act
	P_DEC		skidy
	P_IFNOTZERO	skidy,.no_act1
	P_EXPORT	Pepper_message,skidy
.no_act1
	P_RETURN

.map_line_fin
	P_EXPORT	gbyte1,slopenum
	P_QSPAWN	nullshape,e_line_msg,100,0
	P_BECOME
	P_IMPORT	pbyte1,gbyte1
	P_UNBECOME
	P_SET		skidy,120
	P_IGOTO		.no_act
;------------
.pl_pos_ck
	P_COPYPLAYERPOS
	P_IFLARGER	worldx,ox,.out
	P_IFSMALLER	worldx,childx,.out
	P_IFLARGER	worldz,oz,.out
	P_IFSMALLER	worldz,childz,.out
	P_ZERO		pword1
	P_RETURN
.out
	P_INC		pword1
	P_IFNOTSAME	pword1,10,.mada
	P_FORCE		.game_make
.mada
	P_RETURN
.game_make
	P_TRIGGER	.pl_pos_ck,OFF
	P_ZERO		pword1
	P_IMPORT	pbyte1,ebyte6
	P_SETSWITCH	pbyte2,pbyte1
	P_EXPORT	ebyte6,pbyte1
	P_QSPAWN	zaco_0,e_friend_modore,100,5
	P_EXPORT	gword1,ox
	P_EXPORT	gword2,oz
	P_BECOME
	P_IMPORT	ox,gword1
	P_IMPORT	oz,gword2
	P_UNBECOME
.wait_loop
	P_COPYPLAYERPOS
	P_IMPORT	pbyte1,ebyte6
	P_IFSWITCH	pbyte2,pbyte1,.more_w
	P_IGOTO		.start
.more_w
	P_GOTO		.wait_loop
;-----------
	START_PATH	e_line_msg

;pbyte1 = 22 or 23

	P_TRIGGER	enemy_num_rem,Always

	P_INVISIBLE	ON
	P_IMPORT	pbyte2,Player_friend
;	P_IFSAME	pbyte2,-1,.rem			;partner ga inai
	P_WAIT		60

	P_IFSAME	pbyte1,22,.notfinal
	P_SET		tx,6
.notfinal
	P_ADD		tx,80
	P_ADD		tx,pbyte2
	P_MSG		tx
;.rem
	P_REMOVE

;-----------
modore_msg	equ	50
	START_PATH	e_friend_modore

	P_COLLISIONS	OFF
	P_ALWAYSGENVECS	ON
	P_RANGECHECK	OFF
	P_CLRTYPE	enemy1
	P_ZERO		worldx
	P_ZERO		worldz
	P_RADAROBJ	ra_player
	P_GOSUB		set_friend_shape

	P_TRIGGER	enemy_num_rem,Always

	P_IMPORT	pbyte2,KGameMapPtr
	P_IFNOTSAME	pbyte2,5,.not_sea0
	P_TRIGGER	.keep_sea_hi,Always
	P_GOSUB		sea_init_above
.sea_come_here
	P_GOSUB		.come_sub
	P_IMPORT	worldy,Player1_worldy
	P_DISTLESS	3000,.sea_mid
	P_SET		worldy,-1200
	P_GOTO		.sea_come_here
.sea_mid
	P_FACEPLAYER	y
	P_IMPORT	worldy,Player1_worldy
	P_MOVEINPLAYER	100
	P_DISTLESS	500,.sea_near
	P_SET		worldy,-1200
	P_GOTO		.sea_mid
.sea_near
	P_SET		worldy,-1200
	P_RELTOPLAYER	ON
	P_SETVEL	50
	P_WAIT		3
	P_IGOTO		.in_air
;-----------
.come_sub
	P_IMPORT	childx,Player1_worldx
	P_IMPORT	childz,Player1_worldz
	P_CHASE		worldx,childx
	P_CHASE		worldz,childz
	P_RETURN
;-----------
.not_sea0
	P_TRIGGER	.keep_hi,Always
.come_here
	P_GOSUB		.come_sub
	P_DISTLESS	3000,.mid
	P_GOTO		.come_here
.mid
	P_FACEPLAYER	y
	P_MOVEINPLAYER	100
	P_DISTLESS	500,.near
	P_GOTO		.mid
.near
	P_RELTOPLAYER	ON
	P_SETVEL	50
	P_WAIT		3
	P_IFARWING	.in_air
;;-------- WHEN ROBOT
	P_WAIT		4
	P_ACCEL		0,5
	P_TRIGGER	.keep_hi,OFF
	P_SOUNDEFFECT	transArwing2Robo	;$1c
	P_INDEX		shape,friend_w1,pbyte1
	P_SETANIM	5
	P_WAIT		1
	P_DO		4
	P_ADDANIM	-1,6
	P_NEXT
	P_WAIT		1
	P_INDEX		shape,friend_w2,pbyte1
	P_SETANIM	6
	P_WAIT		1
	P_DO		5
	P_ADDANIM	-1,7
	P_NEXT
	P_SOUNDEFFECT	transArwing2RoboEnd	;$1e
	P_SET		pbyte2,10
.down_again
	P_ADD		worldy,pbyte2
	P_HITGROUND	35,.on_g
	P_ADD		pbyte2,5
	P_GOTO		.down_again
.on_g
	P_SET		worldy,-35
	P_SHOCKCAM	1,64
	P_SOUNDEFFECT	Roboland_s	;$2d

	P_RELTOPLAYER	OFF

	P_SET		pbyte2,25

	P_DO		2
	P_EXPORT	gbyte1,pbyte2
	P_QSPAWN	smoke,e_smoke_simple,100,0
	P_BECOME
	P_SPRITE	0,4
	P_IMPORT	pbyte1,gbyte1
	P_ADD		worldx,pbyte1
	P_ZERO		worldy
	P_UNBECOME
	P_NEG		pbyte2
	P_INEXT

	P_IMPORT	pbyte2,ebyte1
	P_IFNOTZERO	pbyte2,.skip_msg
	P_SET		pbyte2,tx
	P_ADD		pbyte2,modore_msg
	P_MSG		pbyte2
.skip_msg
	P_WAIT		30

	P_SET		pbyte2,-5
	P_TRIGGER	.up,Always

	P_SOUNDEFFECT	transRobo2Arwing	;$1d
	P_DO		5
	P_ADDANIM	1,7
	P_NEXT
	P_WAIT		1
	P_TRIGGER	.up,OFF

	P_ACCEL		40,2

	P_INDEX		shape,friend_w1,pbyte1
	P_SETANIM	1
	P_WAIT		1

	P_DO		4
	P_ADDANIM	1,6
	P_NEXT
	P_WAIT		1
	P_INDEX		shape,friend_shape,pbyte1
	P_SOUNDEFFECT	transRobo2ArwingEnd	;$1f
	P_RELTOPLAYER	ON
	P_IGOTO		.from_robo
.in_air
;;;;;	P_TRIGGER	marker_set,Always
	P_IMPORT	pbyte2,ebyte1
	P_IFNOTZERO	pbyte2,.skip_msg2
	P_SET		pbyte2,tx
	P_ADD		pbyte2,modore_msg
	P_MSG		pbyte2
.skip_msg2
	P_ACCEL		10,5
	P_WAIT		40
.from_robo
	P_ACCEL		20,1
	P_SPACESHIP	ON
	P_ZERO		rotx
	P_DO		8
	P_ADD		rotz,2
	P_NEXT
	P_WAIT		24
	P_DO		8
	P_ADD		rotz,-2
	P_NEXT
	P_SPACESHIP	OFF
	P_RELTOPLAYER	OFF
	P_SETVEL	0
	P_SET		childx,ox
	P_NEG		childx
	P_SET		childz,oz
	P_NEG		childz

	P_ZERO		pbyte1
.back
	P_QSPAWN	marker,e_marker_target,100,0
	P_FINDSHAPE	marker
	P_BECOME
	P_CHASE		worldx,0
	P_CHASE		worldz,0
	P_UNBECOME
	P_BEHINDPLAYER	.fast
.slow
	P_IFNOTZERO	pbyte1,.fast1
	P_MOVEINSHAPE	30
	P_IGOTO		.same
.fast
	P_IFNOTZERO	pbyte1,.fast1
	P_SPAWN		0,0,-30,0,0,0,boost,e_sp_boost_hp,4,0,1
	P_SET		pbyte1,15
.fast1
	P_DEC		pbyte1
	P_MOVEINSHAPE	45
.same
	P_FACESHAPE
	P_ZERO		rotx
	P_IFLARGER	worldx,ox,.more
	P_IFLARGER	worldz,oz,.more
	P_IFSMALLER	worldx,childx,.more
	P_IFSMALLER	worldz,childz,.more
	P_IGOTO		.bye
.more
	P_GOTO		.back

.bye
	P_REMOVE	1
;;;;;	P_TRIGGER	marker_set,OFF
	P_SPAWN		0,0,-30,0,0,0,boost,e_sp_boost,4,0,1
	P_SETVEL	50
	P_FLAGSHAPE
	P_IMPORT	pbyte1,KGameMapPtr
	P_IFNOTSAME	pbyte1,5,.not_sea22
	P_TRIGGER	.keep_sea_hi,OFF
	P_IGOTO		.same_sea2
.not_sea22
	P_TRIGGER	.keep_hi,OFF
.same_sea2
	P_WAITCHASE	rotx,-16
	P_WAIT		50
	P_IMPORT	pbyte1,ebyte6
	P_CLRSWITCH	ap,pbyte1
	P_EXPORT	ebyte6,pbyte1
	P_REMOVE
.keep_hi
	P_SET		worldy,-200
	P_RETURN
.keep_sea_hi
	P_SET		worldy,-1200
	P_RETURN
.up
	P_ADD		worldy,pbyte2
	P_ADD		pbyte2,-5
	P_RETURN

;------------
	START_PATH	e_marker_target

	P_INVISIBLE	ON
	P_REMOVE
;ษออออออป
;บ DOOR บ
;ศออออออผ
	START_PATH	e_1way_door

	P_GOSUB		init_hardslope_soff
	P_PLAYERINCONE	64,.this_color
	P_SET		coltab,id_2_c&WM
.this_color
	P_SETANIM	0
.come_wait
	P_DISTLESS	500,.near
	P_GOTO		.come_wait
.near
	P_PLAYERINCONE	64,.open
	P_GOTO		.come_wait
.open
	P_TRIGGER	.through_ck,WhenThrough
	P_GOSUB		open_door
	P_END
.through_ck
	P_SLOPE		ON
	P_FORCE		.crose
	P_RETURN
.crose
	P_TRIGGER	.through_ck,OFF
.op
	P_IFSAME	animframe,-117,.ok
	P_GOTO		.op
.ok
	P_GOSUB		crose_door
	P_SET		coltab,id_2_c&WM
	P_END
;-----------
	START_PATH	e_hit_open_door_0

	P_GOSUB		init_hardslope_soff
	P_TRIGGER	.open,WhenHitByPlayer
	P_END
.open
	P_FORCE		.open_start
	P_RETURN
.open_start
	P_SOUNDEFTDISTPOS	ob_push_door	;$a8
	P_TRIGGER	.open,OFF
	P_PUSH		roty
	P_SET		pbyte1,roty
	P_NEG		pbyte1  
	P_DO		10
	P_FACEPLAYER	y
	P_INEXT
	P_ADD		roty,pbyte1
