	P_INPLAYERSCONE	-11,11,.keep_pos
	P_CIRCLEPLAYER	10
.keep_pos
	P_DISTLESS	1800,.too_near
	P_DISTLESS	2300,.keep
	P_IMPORT	worldy,Player1_worldy
	P_MOVEINPLAYER	127
	P_GOTO		.loop
.too_near
	P_IMPORT	worldy,Player1_worldy
	P_MOVEINPLAYER	-127
.keep
	P_GOTO		.loop
.end
	P_REMOVE

