	P_BECOME
	P_IMPORT	pbyte1,gbyte1
	P_IMPORT	pbyte2,gbyte2
	P_IMPORT	slopenum,gbyte3
	P_UNBECOME
	P_INEXT

	P_REMOVE
.sound_stg3
