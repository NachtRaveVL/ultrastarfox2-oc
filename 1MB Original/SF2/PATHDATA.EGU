.clr_cker	LOCAL
	P_EXPORT	gbyte1,tx
	P_EXPORT	gbyte2,ty
	P_BECOMESHAPE
	P_IMPORT	ap,gbyte1
	P_CLRSWITCH	ap,pbyte1
	P_IMPORT	ap,gbyte2
	P_CLRSWITCH	ap,pbyte2
	P_UNBECOME
	P_RETURN

