henkei_wait	equ	20

	START_PATH	e_auto_walker

	P_SET		hp,100
	P_INVISIBLE	ON
	P_IMPORT	pbyte1,KGameMapPtr
	P_IFNOTSAME	pbyte1,4,.normal
	P_IMPORT	pbyte1,CurrentLevel
	P_IFSAME	pbyte1,4,.rem
	P_IFSAME	pbyte1,10,.rem
	P_IFSAME	pbyte1,11,.rem
	P_FORCETRANSFORM	robot
	P_REMOVE
.normal
	P_WAIT		henkei_wait		;20
	P_FORCETRANSFORM	robot
.rem
	P_REMOVE
;------------
	START_PATH	e_auto_ufo_lock

	P_FORCETRANSFORM	ufo
	P_PLRTRANSLOCK
	P_REMOVE
;------------
	START_PATH	e_enemynumber_checker

	P_CLRTYPE	enemy1
	P_INVISIBLE	ON
;;;;;test
	P_SET		pword1,1
	P_EXPORT	CurrentSwitch,pword1
	P_EXPORT	SebangoSwitch_0,pword1

	P_SET		pbyte1,4
	P_EXPORT	CurrentEEnemyNumber,pbyte1
	P_EXPORT	EEnemyNumber_0,pbyte1
;;;;;;;;;
	P_IMPORT	pbyte1,CurrentEEnemyNumber
.lp
	P_IMPORT	pbyte2,CurrentEEnemyNumber
	P_IFSAME	pbyte1,pbyte2,.onaji_2
	P_GOSUB		.new_eenemy
	P_PRINT		pbyte2,b,eguchi
	P_SET		pbyte1,pbyte2
.onaji_2
	P_GOTO		.lp
.new_eenemy
	P_IMPORT	pword1,CurrentSwitch
	P_IMPORT	tx,KSebango
	P_IFZERO	tx,.sebango_0
	P_IFSAME	tx,1,.sebango_1
	P_IFSAME	tx,2,.sebango_2
	P_IFSAME	tx,3,.sebango_3
	P_IFSAME	tx,4,.sebango_4
	P_IFSAME	tx,5,.sebango_5
	P_IFSAME	tx,6,.sebango_6
	P_IFSAME	tx,7,.sebango_7
	P_IFSAME	tx,8,.sebango_8
	P_IFSAME	tx,9,.sebango_9
	P_IFSAME	tx,10,.sebango_a
	P_IFSAME	tx,11,.sebango_b
	P_IFSAME	tx,12,.sebango_c
	P_IFSAME	tx,13,.sebango_d
	P_IFSAME	tx,14,.sebango_e
	P_IFSAME	tx,15,.sebango_f
	P_RETURN
.sebango_0
	P_EXPORT	EEnemyNumber_0,pbyte2
	P_EXPORT	SebangoSwitch_0,pword1
	P_RETURN
.sebango_1
	P_EXPORT	EEnemyNumber_1,pbyte2
	P_EXPORT	SebangoSwitch_1,pword1
	P_RETURN
.sebango_2
	P_EXPORT	EEnemyNumber_2,pbyte2
	P_EXPORT	SebangoSwitch_2,pword1
	P_RETURN
.sebango_3
	P_EXPORT	EEnemyNumber_3,pbyte2
	P_EXPORT	SebangoSwitch_3,pword1
	P_RETURN
.sebango_4
	P_EXPORT	EEnemyNumber_4,pbyte2
	P_EXPORT	SebangoSwitch_4,pword1
	P_RETURN
.sebango_5
	P_EXPORT	EEnemyNumber_5,pbyte2
	P_EXPORT	SebangoSwitch_5,pword1
	P_RETURN
.sebango_6
	P_EXPORT	EEnemyNumber_6,pbyte2
	P_EXPORT	SebangoSwitch_6,pword1
	P_RETURN
.sebango_7
	P_EXPORT	EEnemyNumber_7,pbyte2
	P_EXPORT	SebangoSwitch_7,pword1
	P_RETURN
.sebango_8
	P_EXPORT	EEnemyNumber_8,pbyte2
	P_EXPORT	SebangoSwitch_8,pword1
	P_RETURN
.sebango_9
	P_EXPORT	EEnemyNumber_9,pbyte2
	P_EXPORT	SebangoSwitch_9,pword1
	P_RETURN
.sebango_a
	P_EXPORT	EEnemyNumber_a,pbyte2
	P_EXPORT	SebangoSwitch_a,pword1
	P_RETURN
.sebango_b
	P_EXPORT	EEnemyNumber_b,pbyte2
	P_EXPORT	SebangoSwitch_b,pword1
	P_RETURN
.sebango_c
	P_EXPORT	EEnemyNumber_c,pbyte2
	P_EXPORT	SebangoSwitch_c,pword1
	P_RETURN
.sebango_d
	P_EXPORT	EEnemyNumber_d,pbyte2
	P_EXPORT	SebangoSwitch_d,pword1
	P_RETURN
.sebango_e
	P_EXPORT	EEnemyNumber_e,pbyte2
	P_EXPORT	SebangoSwitch_e,pword1
	P_RETURN
