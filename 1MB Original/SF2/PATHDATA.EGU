.keizoku
	P_SET		tx,pbyte2
.make_KEnamyNumber
	P_EXPORT	CurrentEEnemyNumber,tx
	P_EXPORT	CurrentSwitch,pword1
	P_PUSH		pbyte1
	P_SET		pbyte1,tx
	P_SET		pbyte2,5
	P_DO		4
	P_CLRSWITCH	pbyte2,tx
	P_INC		pbyte2
	P_INEXT
	P_DO		4
	P_SHIFTR	pbyte1
	P_INEXT
	P_ADD		tx,pbyte1
	P_PULL		pbyte1
	P_RETURN
