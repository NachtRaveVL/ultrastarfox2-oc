e_kani_rot
	P_GOSUB		pe_kani_0.mk_reg_1
	P_ZERO		pbyte1
	P_DO		4
	P_INC		pbyte1
	P_BECOMECHILD	pbyte1
	P_INC		slopenum
	P_UNBECOME
	P_INEXT
	P_IGOTO		e_slow_rot
e_antenna_rot
	P_SETANIM	0
	P_IGOTO		e_simple_rot
e_mukade_rot
	P_SET		skidy,1
	P_GOSUB		pe_mukade_target.mukade_mk_c
	P_WAIT		5
	P_ZERO		pbyte1
	P_DO		5
	P_INC		pbyte1
	P_BECOMECHILD	pbyte1
	P_SET		ap,20
	P_UNBECOME
	P_INEXT
	P_FLAGCHILD	1
	P_FLAGCHILD	2
	P_FLAGCHILD	3
	P_FLAGCHILD	4
	P_FLAGCHILD	5

	P_WAIT		3

	P_FLAGCHILD	1
	P_FLAGCHILD	2
	P_FLAGCHILD	3
	P_FLAGCHILD	4
	P_FLAGCHILD	5

	P_IGOTO		e_simple_rot
e_fuse_rot
	P_SET		pbyte1,8
	P_SET		ox,68
	P_GOSUB		hajimete_msg_check
	P_SET		tx,-1
	P_SET		ty,22
	P_SETANIM	0
	P_TRIGGER	fuse_jiten,Always
	P_GOTO		e_end
e_d_robo_rot
	P_SET		pbyte1,3
	P_SET		ox,62
	P_GOSUB		hajimete_msg_check
	P_SET		pbyte1,2
	P_EXPORT	KSoundMapPtr,pbyte1
	P_SPAWN		0,-200,0,0,0,0,help,e_help_c,100,0,1
	P_BECOME
	P_INC		skidy
	P_UNBECOME
	P_IGOTO		e_simple_rot
