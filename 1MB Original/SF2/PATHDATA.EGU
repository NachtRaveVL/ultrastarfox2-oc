;ศออออออออออออออออออออออออออออออออออออออออออออออออออออออออออออผ
jumptab
	db	-100,-81,-64,-49,-36,-25,-16,-9,-4,-1
	db	1,4,9,16,25,36,49,64,81,100

div2_jumptab
	db	-50,-40,-32,-24,-18,-12,-8,-4,-2,0
	db	0,2,4,8,12,18,24,32,40,50

slow_jumptab
	db	-50,-50,-40,-40,-32,-32,-25,-25,-18,-18,-12,-12,-8,-8,-4,-4,-2,-2,-1,-1
	db	1,1,2,2,4,4,8,8,12,12,18,18,25,25,32,32,40,40,50,50

;hajimete_msg_tab
;	db	0,80,92,62,74,68
xz2500
	dw	-2500,2500
