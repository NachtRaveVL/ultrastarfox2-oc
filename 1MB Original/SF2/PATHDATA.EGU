	ENDC

	P_REMOVE	2

	P_WAIT		3

	P_SOUNDEFFECT	en_cry1_s	;$79

	P_ZERO		pbyte1
	P_DO		20
	P_AUTOINDEX	B,worldy,jumptab,pbyte1,20
	P_NEXT

	P_SET		pbyte2,100

	P_FLAGCHILD	1
	P_UNLINKCHILD	1
.down_loop
