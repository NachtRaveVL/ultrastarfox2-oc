	P_SET		worldx,childy
	P_IGOTO		.turn
.out_max_x
	P_SET		childroty,64-16
	P_SET		worldx,childx
	P_IGOTO		.turn
.out_min_z
	P_SET		childroty,0-16
	P_SET		worldz,pword1
	P_IGOTO		.turn
.out_max_z
	P_SET		childroty,128-16
	P_SET		worldz,childz
.turn
