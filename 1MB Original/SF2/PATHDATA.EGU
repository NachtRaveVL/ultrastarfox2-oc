	P_ADD		rotx,pbyte1
	P_IFBETWEEN	-1,rotx,65,.taore_cont
	P_SET		rotx,64
	P_IGOTO		.taore_end
.taore_cont
	P_GOTO		.taore_loop
.taore_end
	P_SOUNDEFTDIST	en_land_L
	P_SET		pbyte2,6
	P_DO		8
	P_AUTOINDEX	B,worldy,jumptab,pbyte2,20
	P_NEXT

