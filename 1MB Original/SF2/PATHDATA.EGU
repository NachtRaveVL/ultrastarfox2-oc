.mk_block	LOCAL
	P_DO		4
	P_EXPORT	gbyte1,pbyte1
	P_EXPORT	gbyte2,pbyte2
	P_SPAWN		0,-200,0,0,0,0,t_kichi3,e_base_block,100,2,1
	P_BECOME
	P_IMPORT	pbyte1,gbyte1
	P_IMPORT	pbyte2,gbyte2
	P_INDEX		childx,base_block_x,pbyte2
	P_INDEX		childz,base_block_z,pbyte2
	P_INDEX		childroty,base_block_roty,pbyte2
	P_INC		pbyte2
	P_SETID		pbyte2
	P_UNBECOME
	P_INC		pbyte2
	P_INC		pbyte1
	P_INEXT
	P_RETURN
base_block_x
