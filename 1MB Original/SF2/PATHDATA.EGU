	P_WAITCHASE	rotz,-16
	P_GOTO		.come_loop_again
.wc16
	P_SET		childrotz,16
	P_WAITCHASE	rotz,16
	P_GOTO		.come_loop_again
.spiral
	P_ADD		rotz,childrotz
	P_RETURN
