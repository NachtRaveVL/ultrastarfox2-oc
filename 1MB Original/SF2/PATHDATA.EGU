	START_PATH	e_explain_shape

	P_IFNOTZERO	slopenum,.2nd_target
	P_IMPORT	slopenum,CurrentEEnemyNumber
	P_SET		tx,5
	P_DO		4
	P_CLRSWITCH	tx,slopenum
	P_INC		tx
	P_INEXT
	P_IFNOTZERO	slopenum,.aru
.nai
	P_REMOVE
.2nd_target
	P_IMPORT	slopenum,CurrentEEnemyNumber
	P_DO		4
	P_SHIFTR	slopenum
	P_INEXT
	P_IFZERO	slopenum,.nai
.aru
	P_ZERO		tx
	P_COLLISIONS	OFF
	P_SHADOW	OFF
	P_RANGECHECK	OFF

	P_SET		roty,96

	P_IFZERO	pbyte1,.ok_skidy
	P_DO		pbyte1
;	P_ADD		skidy,4
	P_ADD		pword1,4
	P_INEXT

.ok_skidy
	P_INDEX		shape,EXPLAIN_SHAPE_TAB,pword1
	P_INC		pword1
	P_INDEX		worldx,EXPLAIN_SHAPE_TAB,pword1
	P_INC		pword1
	P_INDEX		worldy,EXPLAIN_SHAPE_TAB,pword1
	P_INC		pword1
	P_INDEX		worldz,EXPLAIN_SHAPE_TAB,pword1

	P_INDEX		pword1,EXPLAIN_PATH_TAB,pbyte2
	P_GOSUB		pword1
e_end
	P_GOTO		e_end
e_dodora_rot
	P_SET		pbyte1,1
	P_EXPORT	KSoundMapPtr,pbyte1
e_boss_rot
	P_GOSUB		boss_no_data
	P_GOTO		e_end
boss_no_data
	P_ZERO		roty
	P_SPAWN		-320,0,0,0,0,0,chr_n,e_nocol_s_off,100,0,1
	P_SPAWN		-200,0,0,0,0,0,chr_o,e_nocol_s_off,100,0,2

	P_SPAWN		0000,0,0,0,0,0,chr_d,e_nocol_s_off,100,0,3
	P_SPAWN		0120,0,0,0,0,0,chr_a,e_nocol_s_off,100,0,4
	P_SPAWN		0220,0,0,0,0,0,chr_t,e_nocol_s_off,100,0,5
	P_SPAWN		0320,0,0,0,0,0,chr_a,e_nocol_s_off,100,0,6
	P_RETURN
e_enban_rot
	P_GOSUB		pe_gattai_enban.mk_gattai_enban
	P_GOTO		e_slow_rot
e_guard_cannon_rot
	P_SPAWN		0,0,-60<<big_l_scale,0,0,0,big_l_b,e_nocol_s_off,100,0,1
	P_SPAWN		0,0,70<<big_l_scale,0,0,0,big_l_f,e_nocol_s_off,100,0,2
	P_GOTO		e_slow_rot
e_step_hyd_rot
	P_GOSUB		pe_step_hydra.mk_damy_arm
	P_SET		rotz,16
	P_GOTO		e_slow_rot
e_tan_kuubo_rot
	P_SET		pbyte2,7
	P_SETRANDOM	pbyte1,1
	P_IFZERO	pbyte1,.s_tekikan
	P_SET		shape,teki_3
	P_ADD		pbyte2,-7
	P_ADD		worldz,600
	P_ADD		worldy,400
.s_tekikan
	P_EXPORT	ebyte5,pbyte2
	P_GOTO		e_slow_rot
e_fuk_kuubo_rot
	P_IMPORT	pbyte1,CurrentLevel
	P_IFSAME	pbyte1,27,.kan_3_kan
	P_SETRANDOM	pbyte2,3
	P_EXPORT	ebyte5,pbyte2
	P_IFZERO	pbyte2,.only_t_3
	P_IFSAME	pbyte2,3,.only_t_kan
	P_IGOTO		.maze
.kan_3_kan
	P_SETRANDOM	pbyte2,7
	P_EXPORT	ebyte5,pbyte2
	P_IFZERO	pbyte2,.only_t_3
	P_IFSAME	pbyte2,7,.only_t_kan
.maze
	P_QSPAWN	teki_3,e_ex_slow_rot,100,0
	P_BECOME
	P_ADD		worldx,700
	P_ADD		worldy,-300
	P_ADD		worldz,1200
	P_UNBECOME
	P_ADD		worldx,-700
	P_ADD		worldy,600
	P_ADD		worldz,800
	P_GOTO		e_slow_rot
.only_t_3
	P_SET		shape,teki_3
	P_ADD		worldz,600
	P_ADD		worldy,400
.only_t_kan
	P_GOTO		e_slow_rot
e_r_ante_rot
	P_GOSUB		pe_room_antenna.mk_r_an
	P_GOTO		e_simple_rot
e_shield_kan_rot
	P_GOSUB		pe_shield_senkan.make_kan_shield
	P_BECOMECHILD	1
	P_SET		ap,0
	P_UNBECOME
	P_BECOMECHILD	2
	P_SET		ap,0
	P_UNBECOME
	P_GOTO		e_slow_rot
e_miss2_rot
	P_GOSUB		pe_sos_baramiss.mk_baramiss_c
	P_GOTO		e_slow_rot
e_speed_s_rot
	P_SPAWN		0<<speed_scale,0,0,0,0,0,speed_lr,e_nocol_s_off,100,0,1
	P_BECOME
	P_SETANIM	0
	P_UNBECOME
	P_SET		rotz,32
	P_GOTO		e_simple_rot
e_b_tank_rot
	P_SPAWN		40<<b_tank_scale,-40<<b_tank_scale,-60<<b_tank_scale,0,-deg90,0,b_tank_1,b_tank_launcher,10,10,1
	P_SPAWN		-40<<b_tank_scale,-40<<b_tank_scale,-60<<b_tank_scale,0,deg90,0,b_tank_1,b_tank_launcher,10,10,2
	P_SPAWN		0,-40<<b_tank_scale,20<<b_tank_scale,0,0,0,b_tank_0,b_tank_launcher,10,10,3
	P_GOTO		e_slow_rot
e_shield_r_rot
	P_SET		coltab,id_1_c&WM
	P_GOSUB		pe_shield_robo.mk_shield_robo

	P_GOTO		e_simple_a12_rot
e_kurage_rot
	P_TRIGGER	anim_add_11,Always
	P_SPAWN		0,0,0,32,0,0,kurage_2,e_kurage_1_c,1,1,1

	P_GOTO		e_simple_rot
	
e_kururin1_rot
	P_FACEVIEW	IMMEDIATE
	P_GOTO		e_kururin1_rot
e_kururin0_rot
	P_SET		roty,128
.kururin_zrot
	P_ADD		rotz,2
	P_GOTO		.kururin_zrot
e_kieru_rot
	P_TRIGGER	.kie_rot,Always
.loop
	P_DO		10
	P_SET		shape,kieru_1
	P_WAIT		1
	P_SET		shape,kieru_0
	P_NEXT
	P_WAIT		60
	P_DO		10
	P_SET		shape,kieru_0
	P_WAIT		1
	P_SET		shape,kieru_1
	P_NEXT
	P_WAIT		60
	P_GOTO		.loop
.kie_rot
	P_ADD		roty,4
	P_RETURN
e_t_kichi_rot
	P_SET		ox,92			;hajimete_base_fox
	P_SET		pbyte1,2		;hajimete_base_flag_num	
	P_GOSUB		hajimete_msg_check
	P_SET		pbyte1,1
	P_ZERO		pbyte2
	P_GOSUB		pe_enemy_base.mk_block
	P_ZERO		pbyte2
	P_DO		4
	P_INC		pbyte2
	P_BECOMECHILD	pbyte2
	P_ZERO		ap
	P_UNBECOME
	P_INEXT
	P_IGOTO		e_slow_rot

e_step_senkan_rot
