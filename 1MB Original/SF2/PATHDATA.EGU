	P_COLLISIONS	ON
	P_SET		slopenum,1
	P_TRIGGER	marker_set,Always
	P_SET		childrotx,98
	P_SET		childroty,10
	P_GOSUB		sos_0_boost
	P_IGOTO		pe_sos_weak_1.come_loop_to
.hentai_dead_ebyte	LOCAL
	P_GDEC		b,ebyte2
	P_RETURN
