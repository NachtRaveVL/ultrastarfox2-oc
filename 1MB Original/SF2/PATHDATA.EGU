	P_TRIGGER	anim_add_12_teku,Always

.loop
	P_IFZERO	pbyte1,.pass1
	P_ACCEL		10,1
	P_DO		pbyte1
	P_WAIT		10
	P_INEXT
	P_ACCEL		0,1
.pass1
	P_DO		16
	P_ADD		roty,slopenum
	P_NEXT

	P_IFZERO	pbyte2,.pass2
	P_ACCEL		10,1
	P_DO		pbyte2
	P_WAIT		10
	P_INEXT
	P_ACCEL		0,1
.pass2
	P_DO		16
	P_ADD		roty,slopenum
	P_NEXT

	
	P_GOTO		.loop
	P_END
