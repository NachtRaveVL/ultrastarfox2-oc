	P_END
.hit_end
	P_BECOMEMOTHER
	P_ZERO		tx
	P_UNBECOME
	P_FLAGMOTHER
	P_HITFLASHTRIG
	P_FORCE		.rot_stop
	P_RETURN
.rot_stop
	P_TRIGGER	.hit_end,OFF

	P_DO		7
	P_ADD		pbyte2,-3
	P_NEXT

	P_TRIGGER	.kaiten_rot,OFF
	P_ZERO		pbyte2

.rot_end
	P_ZERO		tx
.addloop
	P_IFZERO	childrotz,.now_just
	P_IFSAME	childrotz,43,.now_stop
	P_IFSAME	childrotz,85,.now_stop
	P_IFSAME	childrotz,128,.now_atack
	P_IFSAME	childrotz,171,.now_stop
	P_IFSAME	childrotz,213,.now_stop
	P_INC		childrotz
	P_INC		tx
	P_IFNOTSAME	tx,3,.addloop
	P_GOTO		.rot_end
.now_atack
	P_WAIT		1
	P_SOUNDEFTDISTPOS	ob_roll_switch	;$ae
	P_BECOMEMOTHER
	P_SET		tx,1
	P_UNBECOME
	P_FLAGMOTHER
	P_WAIT		2
	P_SOUNDEFFECT	you_are_wrong	;$34*
	P_IGOTO		.now_stop2
.now_just
	P_WAIT		1
	P_SOUNDEFTDISTPOS	ob_roll_switch	;$ae
	P_WAIT		2
	P_SOUNDEFFECT	you_are_right	;$30*
	P_INC		pbyte2
	P_IGOTO		.now_stop2
.now_stop
	P_WAIT		1
	P_SOUNDEFTDISTPOS	ob_roll_switch	;$ae
.now_stop2
	P_IFSWITCH	pbyte1,.now_off_2
	P_IGOTO		.turn_off_ck
.now_off_2
	P_IFNOTZERO	pbyte2,.sonomama
	P_TRIGGER	kaiten_colani,Always
	P_IGOTO		.fuse_turn
.turn_off_ck
	P_IFZERO	pbyte2,.sonomama
	P_SETCOLANIM	3
	P_TRIGGER	kaiten_colani,OFF
.fuse_turn
	P_BECOMEMOTHER
	P_NEG		pbyte2
	P_UNBECOME
	P_DO		7
	P_WAIT		1
	P_NEXT

	P_ADD		worldy,-350
	P_GOSUB		make_demo_target
	P_ADD		worldy,350
	P_BECOME
	P_ZERO		rotz
	P_SET		tx,40
	P_SET		pword1,-350
