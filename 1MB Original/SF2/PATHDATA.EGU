		P_TRIGGER	sos_fire_must,OFF

		P_SETRANDOM	pbyte1,7
		P_ADD		pbyte1,-4
		P_DO		10
		P_ADD		roty,pbyte1
		P_NEXT
	P_NEXT

	P_GOSUB		.boost_flag

