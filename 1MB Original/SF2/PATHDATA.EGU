	P_SETSWITCH	ty,pbyte2

	P_EXPORT	gbyte1,tx
	P_EXPORT	gbyte2,ty
	P_DEC		tx
	P_DEC		tx
	P_INDEX		pword1,mogu_base_x,tx
	P_EXPORT	gword1,pword1
	P_INDEX		pword1,mogu_base_z,tx
	P_EXPORT	gword2,pword1
	P_RETURN

