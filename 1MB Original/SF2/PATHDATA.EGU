.fuse_onoff
	P_FORCE		.change
	P_RETURN
.change
	P_TRIGGER	.fuse_onoff,OFF

	P_GOSUB		turn_fuse

	P_EXPLODE	;test
;	P_GOTO		.again

turn_fuse
	P_IFSWITCH	pbyte2,.turn_on
;.turn_off
	P_TRIGGER	marker_set,OFF
	P_SET		ty,22

;	P_WAIT		5	;10
.mada
	P_IFSAME	animframe,-128,.top
	P_GOTO		.mada
.top
	P_TRIGGER	fuse_jiten,OFF

	P_SETCOLANIM	3

	P_DO		6
	P_DO		2
	P_DEC		ty
	P_ADD		roty,ty
	P_ADD		childroty,ty
	P_NEXT
	P_ADDANIM	1,7
	P_NEXT

	P_SOUNDEFTDISTPOS	ob_koma_roll	;$ac
	P_WAIT		1
.mada2
	P_DEC		ty
	P_IFZERO	ty,.end_rot
	P_ADD		roty,ty
	P_ADD		childroty,ty
	P_GOTO		.mada2
.end_rot
	P_PUSH		pbyte1
;	P_IMPORT	pbyte1,KenemyNumber
;	P_IFZERO	pbyte1,.no_friend
	P_IMPORT	pbyte1,Player_friend
	P_IFSAME	pbyte1,-1,.no_friend
	P_ADD		pbyte1,fuse_stop_msg
	P_MSG		pbyte1
.no_friend
	P_PULL		pbyte1
	P_CLRDEMOSHAPE
	P_GDEC		b,KEnemyNumber
	P_RADAROBJ	ra_off
	P_SCORE		ox

	P_SETANIM	6

	P_SETSWITCH	pbyte2
	P_WAIT		9

	P_RETURN

.turn_on
	P_TRIGGER	marker_set,Always
	P_SETANIM	6
	P_ZERO		ty

	P_DO		22
	P_INC		ty
	P_ADD		roty,ty
	P_ADD		childroty,ty
	P_IFSAME	ty,8,.oto
	P_IFSAME	ty,20,.oto
	P_IGOTO		.nos
.oto
	P_SOUNDEFTDISTPOS	ob_koma_roll	;$ac
.nos
	P_NEXT

	P_WAIT		1
	P_ZERO		pword1

	P_DO		6
	P_DO		2
	P_INC		pword1
	P_IFNOTSAME	pword1,8,.noss
	P_SOUNDEFTDISTPOS	ob_koma_roll	;$ac
.noss
	P_ADD		roty,ty
	P_ADD		childroty,ty
	P_NEXT
	P_ADDANIM	-1,7
	P_NEXT

	P_SET		tx,-1
	P_SETANIM	0
	P_ZERO		pword1
	P_TRIGGER	fuse_jiten,Always

	P_CLRSWITCH	pbyte2
	P_WAIT		9
	P_GINC		b,KEnemyNumber
	P_RADAROBJ	ra_enemy
	P_RETURN
fuse_jiten
