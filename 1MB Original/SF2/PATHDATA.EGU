	P_CHILDDEAD	4,.wait_c_loop

	P_DO		10
	P_BECOMECHILD	1
	P_ADD		childy,24
	P_UNBECOME
	P_NEXT
.mouaru
	P_DO		24
	P_FACEPLAYER
	P_BECOMECHILD	1
	P_CHASE		childrotx,-70
	P_UNBECOME
	P_NEXT

	P_SET		tx,2
