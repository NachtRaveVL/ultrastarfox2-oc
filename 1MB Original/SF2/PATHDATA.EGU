.dan_st	LOCAL
	P_SET		weapontype,16
	P_SET		pbyte1,1
.fune_same	LOCAL
	P_RANGECHECK	OFF
	P_SHADOW	OFF
	P_CLRTYPE	enemy1
	P_TRIGGER	.sw_stepped,WhenFlagged
	P_MOVEPLAYER	ON
	P_SET		skidy,hp
	P_GOSUB		init_hardslope
.car_loop
	P_CLEARSTACK
	P_SET		pbyte2,skidy
	P_ZERO		skidy
.root_again
	P_IFSAME	pbyte2,weapontype,.car_loop
	  P_IFSAME		pbyte1,2,.for_fune
	  P_INDEX		ty,car_fuse_root,pbyte2
	  P_IGOTO		.same
.for_fune
	  P_INDEX		ty,fune_fuse_root,pbyte2
.same
	  P_INDEX		slopenum,track_ang,ty
	  P_IFSAME		pbyte1,2,.car_y_rot
	  P_ADD			slopenum,128
.car_y_rot
	  P_IFSAME		roty,slopenum,.car_ry_end
	  P_CHASE		roty,slopenum
	  P_GOTO		.car_y_rot
.car_ry_end
	  P_ADD		ty,ty
	  P_INDEX		slopenum,track_move,ty
	  P_INC		ty
	  P_INDEX		tx,track_move,ty
	  P_DO		60
	    P_DO	2
	      P_ADD		worldx,slopenum
	      P_ADD		worldz,tx
	    P_INEXT
	  P_NEXT
	P_INC			pbyte2
	P_GOTO		.root_again

.sw_stepped
	P_FLAGCHILD	1
	P_RETURN
