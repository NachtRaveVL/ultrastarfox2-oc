	c_name1	<TAKUMI KAWAGOE>
	c_name1	<YASUHIRO KAWAGUCHI>
	c_title	<GRAPHIC DESIGN>
	c_name1	<MASANAO ARIMOTO>
	c_title	<3D SHAPE DESIGN>
	c_name1	<TSUYOSHI WATANABE>
	c_title	<3D SYSTEM PROGRAM>
	c_name1	<PETE WARNES>
